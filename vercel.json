{
  "version": 2,
  "name": "elibrary",
  "builds": [
    {
      "src": "elib/project/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "elib/project/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/elib/project/server.js"
    },
    {
      "src": "/admin-dashboard",
      "dest": "/elib/project/public/admin-dashboard.html"
    },
    {
      "src": "/user-portal",
      "dest": "/elib/project/public/user-portal.html"
    },
    {
      "src": "/login",
      "dest": "/elib/project/public/login.html"
    },
    {
      "src": "/landing",
      "dest": "/elib/project/public/landing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/elib/project/public/landing.html"
    }
  ],  "env": {
    "NODE_ENV": "production"
  }
}
