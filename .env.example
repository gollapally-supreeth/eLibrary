# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/elibrary?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=production
PORT=3000

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-here-change-this-in-production

# Application Configuration
APP_NAME=eLibrary
APP_URL=https://your-app-name.vercel.app

# JWT Configuration (if using JWT)
JWT_SECRET=your-jwt-secret-key-here

# Google Auth (if using Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
